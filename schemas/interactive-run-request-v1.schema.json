{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentteam:schema:interactive-run-request:v1",
  "$defs": {
    "CatalogKind": {
      "enum": [
        "assistant-definition",
        "team-template"
      ],
      "title": "CatalogKind",
      "type": "string"
    },
    "CatalogRefV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/CatalogKind"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "content_hash"
      ],
      "title": "CatalogRefV1",
      "type": "object"
    },
    "EvidenceSettingsV1": {
      "additionalProperties": false,
      "properties": {
        "retain_raw_streams": {
          "default": true,
          "description": "Keep raw vendor output in the local, gitignored archive.",
          "title": "Retain Raw Streams",
          "type": "boolean"
        }
      },
      "title": "EvidenceSettingsV1",
      "type": "object"
    },
    "HarnessId": {
      "description": "Harness identifiers used in records and profiles (plan section 2).",
      "enum": [
        "claude-code",
        "codex",
        "grok"
      ],
      "title": "HarnessId",
      "type": "string"
    },
    "LimitsV1": {
      "additionalProperties": false,
      "description": "May lower but never raise the section 9 caps.",
      "properties": {
        "attempt_seconds": {
          "anyOf": [
            {
              "maximum": 900,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Seconds"
        },
        "transient_retries": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transient Retries"
        }
      },
      "title": "LimitsV1",
      "type": "object"
    },
    "MemberRuntimeOverrideV1": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        }
      },
      "title": "MemberRuntimeOverrideV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "interactive-run-request",
      "title": "Kind",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/CatalogRefV1"
    },
    "workspace": {
      "minLength": 1,
      "title": "Workspace",
      "type": "string"
    },
    "workspace_layout": {
      "const": "shared-supplied",
      "default": "shared-supplied",
      "title": "Workspace Layout",
      "type": "string"
    },
    "goal": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "done_when": {
      "items": {
        "type": "string"
      },
      "title": "Done When",
      "type": "array"
    },
    "members": {
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$": {
          "$ref": "#/$defs/MemberRuntimeOverrideV1"
        }
      },
      "title": "Members",
      "type": "object"
    },
    "output_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Dir"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceSettingsV1"
    },
    "limits": {
      "$ref": "#/$defs/LimitsV1"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "target",
    "workspace",
    "goal"
  ],
  "title": "InteractiveRunRequestV1",
  "type": "object"
}
