{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentteam:schema:provider-doctor:v1",
  "$defs": {
    "CapabilityLevel": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ],
      "title": "CapabilityLevel",
      "type": "string"
    },
    "DoctorCheckV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "DoctorCheckV1",
      "type": "object"
    },
    "ProviderCapabilitiesV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "provider-capabilities",
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Provider",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "persistent_turns": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "recovery": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "permission_events": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "workspace_enforcement": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "tool_filtering": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "native_spawn_control": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "process_stop_observability": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "local_state_deletion": {
          "$ref": "#/$defs/CapabilityLevel"
        },
        "provider_history_deletion": {
          "$ref": "#/$defs/CapabilityLevel"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "provider",
        "version",
        "persistent_turns",
        "recovery",
        "permission_events",
        "workspace_enforcement",
        "tool_filtering",
        "native_spawn_control",
        "process_stop_observability",
        "local_state_deletion",
        "provider_history_deletion"
      ],
      "title": "ProviderCapabilitiesV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "provider-doctor",
      "title": "Kind",
      "type": "string"
    },
    "provider": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "title": "Provider",
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/ProviderCapabilitiesV1"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/DoctorCheckV1"
      },
      "title": "Checks",
      "type": "array"
    },
    "model_calls": {
      "const": 0,
      "default": 0,
      "title": "Model Calls",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "provider",
    "checked_at",
    "status",
    "capabilities",
    "checks"
  ],
  "title": "ProviderDoctorV1",
  "type": "object"
}
