{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentteam:schema:control-request:v1",
  "$defs": {
    "ControlAction": {
      "enum": [
        "work.create",
        "work.update",
        "work.assign",
        "completion.propose"
      ],
      "title": "ControlAction",
      "type": "string"
    },
    "ControlActor": {
      "enum": [
        "user",
        "lead",
        "member"
      ],
      "title": "ControlActor",
      "type": "string"
    },
    "TeamTaskStatus": {
      "enum": [
        "blocked",
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled",
        "abandoned"
      ],
      "title": "TeamTaskStatus",
      "type": "string"
    },
    "WorkItemV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "work-item",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run-[0-9a-z](?:[0-9a-z-]{0,78}[0-9a-z])?$",
          "title": "Run Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "owner": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "title": "Owner",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TeamTaskStatus"
        },
        "blocked_by": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
            "type": "string"
          },
          "title": "Blocked By",
          "type": "array"
        },
        "workspace_access": {
          "$ref": "#/$defs/WorkspaceAccess",
          "default": "read-only"
        },
        "result_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "id",
        "subject",
        "owner",
        "status"
      ],
      "title": "WorkItemV1",
      "type": "object"
    },
    "WorkspaceAccess": {
      "enum": [
        "read-only",
        "workspace-write"
      ],
      "title": "WorkspaceAccess",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "control-request",
      "title": "Kind",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-z](?:[0-9a-z-]{0,78}[0-9a-z])?$",
      "title": "Run Id",
      "type": "string"
    },
    "source_turn_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Turn Id"
    },
    "actor": {
      "$ref": "#/$defs/ControlActor"
    },
    "actor_member": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Member"
    },
    "action": {
      "$ref": "#/$defs/ControlAction"
    },
    "work_item": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkItemV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "work_item_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Item Id"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/TeamTaskStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "owner": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "completion_proposal": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Proposal"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "run_id",
    "actor",
    "action"
  ],
  "title": "ControlRequestV1",
  "type": "object"
}
